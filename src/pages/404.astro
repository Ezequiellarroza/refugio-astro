---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import type { SEOProps } from '@/types/seo';

const seo: SEOProps = {
  title: 'Próximamente | Refugio del Valle',
  description: 'Estamos preparando este espacio.',
  noindex: true,
};
---

<BaseLayout seo={seo}>
  <section class="flex min-h-[calc(100vh-200px)] items-center py-20 md:py-32">
    <div class="mx-auto grid w-full max-w-6xl grid-cols-1 items-center gap-12 px-4 md:grid-cols-2 md:gap-16">
      <div class="md:order-2">
        <img
          src="/images/404/404-ciervo.jpg"
          alt="Ciervo en el bosque"
          class="h-auto max-h-[500px] w-full rounded-2xl object-cover shadow-lg"
        />
      </div>

      <div class="text-center md:order-1 md:text-left">
        <p class="mb-4 text-sm font-medium uppercase tracking-wide text-verde-bosque">
          Refugio del Valle
        </p>
        <h1 class="mb-6 font-display text-5xl font-bold text-verde-bosque md:text-6xl">
          Próximamente
        </h1>
        <p class="mb-10 text-lg leading-relaxed text-oscuro-suave/70 md:text-xl">
          Estamos preparando este espacio.
        </p>
        <Button href="/" variant="primary">Volver al home</Button>
      </div>
    </div>
  </section>
</BaseLayout>
