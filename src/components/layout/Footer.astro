---
import { Phone, MapPin } from 'lucide-react';
import { SOCIAL_LINKS } from '@/lib/seo-defaults';

const NAV_LINKS = [
  { label: 'Inicio', href: '/' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'El Lugar', href: '/el-lugar' },
  { label: 'Actividades', href: '/actividades' },
  { label: 'English Camp', href: '/english-camp' },
  { label: 'FAQ', href: '/faq' },
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-verde-bosque text-piedra-clara">
  <div class="h-1 bg-gradient-to-r from-ambar via-ambar-claro to-ambar"></div>

  <div class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-4">
        <span class="font-display text-2xl font-bold text-white">
          Refugio del Valle
        </span>
        <p class="text-sm leading-relaxed text-piedra-clara/80">
          Un espacio rodeado de sierras y naturaleza en Tandil, ideal para
          desconectar, compartir y vivir experiencias únicas.
        </p>
        <div class="flex gap-4 pt-2">
          <a
            href={SOCIAL_LINKS.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="text-piedra-clara/70 transition-colors duration-300 hover:text-ambar"
            aria-label="Instagram"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
          <a
            href={SOCIAL_LINKS.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="text-piedra-clara/70 transition-colors duration-300 hover:text-ambar"
            aria-label="Facebook"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="mb-4 font-display text-lg font-semibold text-white">
          Navegación
        </h4>
        <ul class="flex flex-col gap-2">
          {NAV_LINKS.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class="text-sm text-piedra-clara/70 transition-colors duration-300 hover:text-ambar"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="mb-4 font-display text-lg font-semibold text-white">
          Contacto
        </h4>
        <ul class="flex flex-col gap-3">
          <li class="flex items-start gap-3 text-sm text-piedra-clara/80">
            <MapPin size={16} className="mt-0.5 shrink-0 text-ambar" />
            Cereseto 2197, Tandil, Buenos Aires
          </li>
          <li>
            <a
              href="tel:+5492494672662"
              class="flex items-center gap-3 text-sm text-piedra-clara/80 transition-colors duration-300 hover:text-ambar"
            >
              <Phone size={16} className="shrink-0 text-ambar" />
              0249 15-467-2662
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="mb-4 font-display text-lg font-semibold text-white">
          Ubicación
        </h4>
        <div class="h-40 overflow-hidden rounded-xl">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3170.728102054451!2d-59.115663299999994!3d-37.37261!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95911f3a241cd745%3A0xce98347f75e6799!2sRefugio%20del%20valle!5e0!3m2!1ses!2sar!4v1774895723387!5m2!1ses!2sar"
            width="100%"
            height="100%"
            style="border: 0; display: block;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación Refugio del Valle"
          ></iframe>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-2 px-6 py-6 text-xs text-piedra-clara/50 sm:flex-row">
      <span>
        &copy; {currentYear} Refugio del Valle. Todos los derechos reservados.
      </span>
      <span>
        Desarrollado por{' '}
        <a
          href="https://trinity.com.ar"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ambar transition-colors duration-300 hover:text-ambar-claro"
        >
          Trinity
        </a>
      </span>
    </div>
  </div>
</footer>
