---
import { ChevronDown } from 'lucide-react';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import faq from '@/data/faq';
---

<section class="bg-piedra-clara py-24">
  <div class="mx-auto max-w-3xl px-6">
    <SectionTitle
      subtitle="Preguntas Frecuentes"
      title="Todo lo que necesitás saber"
    />

    <div class="reveal mt-12 rounded-2xl bg-white p-6 shadow-md md:p-8">
      {
        faq.map((item) => (
          <details class="faq-item border-b border-piedra-clara last:border-b-0">
            <summary class="flex cursor-pointer items-center justify-between py-5 text-left transition-colors hover:text-verde-sierra">
              <span class="pr-4 font-medium text-oscuro-suave">
                {item.question}
              </span>
              <ChevronDown
                size={20}
                className="faq-chevron shrink-0 text-verde-sierra transition-transform duration-300"
              />
            </summary>
            <div class="pb-5">
              <p class="leading-relaxed text-oscuro-suave/70">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Oculta el marker nativo del <summary> en todos los navegadores */
  .faq-item summary {
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  /* Rota el chevron 180° cuando el <details> está abierto */
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }
</style>
