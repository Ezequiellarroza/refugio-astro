---
const stats = [
  { numero: '7', descripcion: 'Tirolesas con progresión técnica' },
  { numero: '21', descripcion: 'Puentes colgantes entre árboles' },
  { numero: '60', descripcion: 'Arneses simultáneos en el circuito' },
  { numero: '300+', descripcion: 'Alumnos por día de capacidad' },
];
---

<section class="bg-piedra-clara py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal text-center">
      <span
        class="inline-block rounded-full bg-ambar/10 px-4 py-1.5 text-xs font-medium uppercase tracking-widest text-tierra"
      >
        En números
      </span>
      <h2
        class="mt-6 font-display text-3xl font-bold leading-tight text-verde-bosque sm:text-4xl md:text-5xl"
      >
        La escala de la propuesta
      </h2>
    </div>

    <div class="mt-16 grid grid-cols-2 gap-6 md:grid-cols-4 md:gap-8">
      {
        stats.map((stat, index) => (
          <div class={`reveal stagger-${index + 1} text-center`}>
            <p class="font-display text-5xl font-bold text-verde-sierra md:text-6xl lg:text-7xl">
              {stat.numero}
            </p>
            <p class="mt-3 text-sm font-medium text-oscuro-suave md:text-base">
              {stat.descripcion}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
