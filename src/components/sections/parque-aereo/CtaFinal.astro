---
import Button from '@/components/ui/Button.astro';
---

<section class="bg-verde-bosque py-20 md:py-28">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <div class="reveal">
      <h2
        class="font-display text-3xl font-bold leading-tight text-white sm:text-4xl md:text-5xl"
      >
        Sumá Parque Aéreo a tu próximo viaje educativo
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-base text-piedra-clara/90 md:text-lg">
        Coordinemos las fechas, los grupos y la propuesta a medida de tu
        institución.
      </p>
      <div class="mt-10">
        <Button href="/contacto" variant="primary" size="lg">
          Contactanos
        </Button>
      </div>
    </div>
  </div>
</section>
