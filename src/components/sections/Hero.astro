---
import { ChevronDown } from 'lucide-react';
import Button from '@/components/ui/Button.astro';
---

<section class="relative h-screen overflow-hidden">
  <video
    class="absolute inset-0 h-full w-full object-cover"
    src="/videos/hero.mp4"
    autoplay
    muted
    loop
    playsinline
  ></video>

  <div class="absolute inset-0 bg-linear-to-b from-oscuro/70 via-verde-bosque/50 to-transparent"></div>

  <div class="relative z-10 flex h-full flex-col items-center justify-center px-6 text-center">
    <span class="mb-4 animate-fade-in text-sm font-medium uppercase tracking-widest text-ambar-claro">
      Sierras de Tandil · Capacidad hasta 230 huéspedes
    </span>

    <h1 class="animate-fade-up font-display text-3xl font-bold leading-tight text-white sm:text-4xl md:text-5xl lg:text-7xl">
      <span class="text-ambar-claro">Turismo para Grupos</span>
    </h1>

    <p
      class="mx-auto mt-6 max-w-2xl animate-fade-up text-lg text-piedra-clara/90 md:text-xl"
      style="animation-delay: 0.2s;"
    >
      La base de viajes escolares más elegida de Buenos Aires
    </p>
    <p
      class="mx-auto mt-3 max-w-2xl animate-fade-up text-base text-ambar-claro md:text-lg"
      style="animation-delay: 0.3s;"
    >
      +120 instituciones · +10.000 alumnos por año
    </p>

    <div
      class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row"
      style="animation: fade-up 0.8s ease-out 0.4s forwards; opacity: 0;"
    >
      <Button href="/el-lugar" variant="primary" size="lg">
        Conocé Refugio del Valle
      </Button>
      <Button
        href="/contacto"
        variant="white"
        size="lg"
      >
        Contactanos
      </Button>
    </div>
  </div>

  <a
    href="/nosotros"
    class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2 animate-bounce text-white/70 transition-colors hover:text-ambar-claro"
    aria-label="Scroll hacia abajo"
  >
    <ChevronDown size={32} />
  </a>
</section>
