---
import { Phone, MapPin } from 'lucide-react';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import ContactoForm from '@/components/sections/ContactoForm';
---

<section class="bg-linear-to-br from-ambar to-ambar-claro py-24">
  <div class="mx-auto max-w-7xl px-6">
    <SectionTitle
      subtitle="Contacto"
      title="Planificá la experiencia"
      description="Dejanos esta información y nosotros te contactaremos. También podés llamarnos o escribirnos por WhatsApp."
      amber
    />

    <div class="mt-16 grid gap-12 lg:grid-cols-2">
      <div class="reveal">
        <ContactoForm client:visible />
      </div>

      <div class="flex flex-col gap-8">
        <div class="reveal space-y-6">
          <div class="flex items-start gap-4">
            <div
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white/80 text-verde-sierra"
            >
              <Phone size={22} />
            </div>
            <div>
              <h4 class="font-display font-semibold text-oscuro">
                Teléfono / WhatsApp
              </h4>
              <a
                href="tel:+5492494672662"
                class="text-oscuro-suave/80 hover:text-verde-bosque transition-colors"
              >
                0249 15-467-2662
              </a>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white/80 text-verde-sierra"
            >
              <MapPin size={22} />
            </div>
            <div>
              <h4 class="font-display font-semibold text-oscuro">Dirección</h4>
              <p class="text-oscuro-suave/80">
                Cereseto 2197, Tandil, Buenos Aires
              </p>
            </div>
          </div>
        </div>

        <div
          class="reveal flex-1 min-h-[250px] overflow-hidden rounded-2xl shadow-md"
        >
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3170.728102054451!2d-59.115663299999994!3d-37.37261!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95911f3a241cd745%3A0xce98347f75e6799!2sRefugio%20del%20valle!5e0!3m2!1ses!2sar!4v1774895723387!5m2!1ses!2sar"
            width="100%"
            height="100%"
            style="border: 0; display: block; min-height: 250px;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación Refugio del Valle"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
